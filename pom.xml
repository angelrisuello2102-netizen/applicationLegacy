<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>MiApplicationEAR</groupId>
  <artifactId>MiApplicationEAR</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>ear</packaging>
  <description>!!!EAR resources from the root directory need to be moved under src/main/application!!!</description>
  
  <dependencies>
  	<dependency>
        <groupId>MiModuleWeb</groupId> <!-- Verifica que coincida con el groupId real del WAR -->
        <artifactId>MiModuleWeb</artifactId>
        <version>0.0.2-SNAPSHOT</version> <!-- Pon la versión exacta del pom.xml de tu WAR -->
        <type>war</type>
    </dependency>
  </dependencies>
  
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-ear-plugin</artifactId>
        <version>3.0.2</version>
        <configuration>
          <version>7</version>
          <defaultLibBundleDir>lib</defaultLibBundleDir>
          <modules>
          	 <webModule>
                <groupId>MiModuleWeb</groupId>
                <artifactId>MiModuleWeb</artifactId>
                <contextRoot>/MiModuleWeb</contextRoot>
              </webModule>            
          </modules>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>